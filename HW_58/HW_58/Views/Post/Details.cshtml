@model HW_58.Models.Post

@{
    ViewData["Title"] = "Post details";
}

<div class="container">
    <div class="mx-auto" style="max-width: 600px;">

        <div class="d-flex justify-content-center gap-2 mb-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                View feed
            </a>

            @if (Model.User != null)
            {
                <a asp-controller="Profile"
                   asp-action="Details"
                   asp-route-id="@Model.UserId"
                   class="btn btn-secondary">
                    Back to profile
                </a>
            }

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="Post" asp-action="Create" class="btn btn-success">
                    Create my post
                </a>
            }
        </div>

        <div class="card">
            <div class="card-header">
                @if (Model.User != null)
                {
                    <a asp-controller="Profile"
                       asp-action="Details"
                       asp-route-id="@Model.UserId"
                       class="text-decoration-none text-dark">
                        <strong>@Model.User.UserName</strong>
                    </a>
                }
                else
                {
                    <strong>Unknown user</strong>
                }
            </div>

            <img src="@Model.ImagePath"
                 class="card-img-top"
                 alt="Post image"
                 style="max-height: 650px; object-fit: cover;" />

            <div class="card-body">
                <p><strong>Likes:</strong> @Model.LikesCount</p>
                <p><strong>Comments:</strong> @Model.CommentsCount</p>
                <p>@Model.Description</p>
                <p class="text-muted">@Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</p>
            </div>
        </div>

    </div>
</div>