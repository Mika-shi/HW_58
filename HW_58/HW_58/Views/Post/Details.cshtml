@model HW_58.Models.Post

@{
    ViewData["Title"] = "Post details";
    bool hasLiked = ViewBag.HasLiked == true;
}

<div class="container">
    <div class="mx-auto" style="max-width: 600px;">

        <div class="d-flex justify-content-center gap-2 mb-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                View feed
            </a>

            @if (Model.User != null)
            {
                <a asp-controller="Profile"
                   asp-action="Details"
                   asp-route-id="@Model.UserId"
                   class="btn btn-secondary">
                    Back to profile
                </a>
            }

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="Post" asp-action="Create" class="btn btn-success">
                    Create my post
                </a>
            }
        </div>

        <div class="card">
            <div class="card-header">
                @if (Model.User != null)
                {
                    <a asp-controller="Profile"
                       asp-action="Details"
                       asp-route-id="@Model.UserId"
                       class="text-decoration-none text-dark">
                        <strong>@Model.User.UserName</strong>
                    </a>
                }
                else
                {
                    <strong>Unknown user</strong>
                }
            </div>

            <img src="@Model.ImagePath"
                 class="card-img-top"
                 alt="Post image"
                 style="max-height: 650px; object-fit: cover;" />

            <div class="card-body">
                <div class="mb-3">
                    <p><strong>Likes:</strong> @Model.LikesCount</p>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        if (hasLiked)
                        {
                            <button class="btn btn-secondary" disabled>
                                Liked
                            </button>
                        }
                        else
                        {
                            <form asp-controller="Post"
                                  asp-action="Like"
                                  asp-route-id="@Model.Id"
                                  method="post">
                                <button type="submit" class="btn btn-outline-primary">
                                    Like
                                </button>
                            </form>
                        }
                    }
                </div>
                <p><strong>Comments:</strong> @Model.CommentsCount</p>
                <p>@Model.Description</p>
                
                  
                <hr />

                <h5>Comments</h5>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form asp-controller="Post"
                          asp-action="AddComment"
                          method="post"
                          class="mb-3">

                        <input type="hidden" name="postId" value="@Model.Id" />

                        <div class="mb-2">
                            <textarea name="text"
                      class="form-control"
                      rows="3"
                      placeholder="Write a comment..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Add comment
                        </button>
                    </form>
                }

                @if (Model.Comments.Count == 0)
                {
                    <p>No comments yet.</p>
                }
                else
                {
                    @foreach (Comment comment in Model.Comments.OrderBy(comment => comment.CreatedOn))
                    {
                        <div class="border rounded p-2 mb-2">
                            <p class="mb-1">
                                <strong>
                                    @(comment.User != null ? comment.User.UserName : "Unknown user")
                                </strong>
                            </p>

                            <p class="mb-1">@comment.Text</p>

                            <small class="text-muted">
                                @comment.CreatedOn.ToString("dd.MM.yyyy HH:mm")
                            </small>
                        </div>
                    }
                }
                
                <p class="text-muted">@Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</p>
            </div>
        </div>

    </div>
</div>