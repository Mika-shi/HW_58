@model List<HW_58.Models.Post>

@{
    ViewData["Title"] = "Feed";
    bool isAuthenticated = ViewBag.IsAuthenticated == true;
}

<div class="feed-page">

    @if (!isAuthenticated)
    {
        <div class="text-center">
            <h2>Welcome to Instagram</h2>
            <p>Log in or register to see your feed.</p>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary">
                Log in
            </a>

            <a asp-controller="Account"
               asp-action="Register"
               class="btn btn-outline-secondary">
                Register
            </a>
        </div>
    }
    else if (Model.Count == 0)
    {
        <div class="text-center">
            <p>Your feed is empty.</p>
            <p>Follow other users to see their posts here.</p>

            <a asp-controller="Users"
               asp-action="Search"
               class="btn btn-primary">
                Search users
            </a>
        </div>
    }
    else
    {
        @foreach (Post post in Model)
        {
            <div class="feed-post-card">

                <div class="feed-post-header">
                    @if (post.User != null)
                    {
                        <a asp-controller="Profile"
                           asp-action="Details"
                           asp-route-id="@post.UserId"
                           class="feed-user-link">

                            <img src="@post.User.AvatarPath"
                                 class="feed-user-avatar"
                                 alt="Avatar" />

                            <strong>@post.User.UserName</strong>
                        </a>
                    }
                </div>

                <a asp-controller="Post"
                   asp-action="Details"
                   asp-route-id="@post.Id">

                    <img src="@post.ImagePath"
                         class="feed-post-image"
                         alt="Post" />
                </a>

                <div class="feed-post-body">

                    <p class="mb-2">
                        <strong>Likes:</strong> @post.LikesCount
                        &nbsp;&nbsp;
                        <strong>Comments:</strong> @post.CommentsCount
                    </p>

                    @if (post.User != null)
                    {
                        <p class="mb-2">
                            <strong>@post.User.UserName</strong>
                            @post.Description
                        </p>
                    }

                    <a asp-controller="Post"
                       asp-action="Details"
                       asp-route-id="@post.Id"
                       class="feed-view-comments">
                        View post
                    </a>

                </div>

            </div>
        }
    }

</div>