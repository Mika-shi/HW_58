@model List<HW_58.Models.User>

@{
    ViewData["Title"] = "Search users";
    string keyword = ViewBag.Keyword;
}

<h1>Search users</h1>

<form asp-controller="Users" asp-action="Search" method="get" class="mb-4">
    <div class="input-group">
        <input type="text"
               name="keyword"
               value="@keyword"
               class="form-control"
               placeholder="Enter login, email, name or bio" />

        <button type="submit" class="btn btn-primary">
            Search
        </button>
    </div>
</form>

@if (string.IsNullOrWhiteSpace(keyword))
{
    <p>Enter keyword to search users.</p>
}
else if (Model.Count == 0)
{
    <p>No users found.</p>
}
else
{
    <div class="list-group">
        @foreach (User user in Model)
        {
            <a asp-controller="Profile"
               asp-action="Details"
               asp-route-id="@user.Id"
               class="list-group-item list-group-item-action">

                <div class="d-flex align-items-center">
                    <img src="@user.AvatarPath"
                         alt="Avatar"
                         style="width: 60px; height: 60px; object-fit: cover; border-radius: 50%; margin-right: 15px;" />

                    <div>
                        <h5 class="mb-1">@user.UserName</h5>
                        <p class="mb-1">@user.FullName</p>
                        <small>@user.Email</small>

                        @if (!string.IsNullOrWhiteSpace(user.Bio))
                        {
                            <p class="mb-0 text-muted">@user.Bio</p>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
}