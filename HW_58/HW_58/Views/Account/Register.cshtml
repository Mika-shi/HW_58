@model HW_58.ViewModels.RegisterViewModel
@using HW_58.Models.Enums

@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">
    <div class="auth-card auth-card-register">
        <div class="auth-logo">Instagram</div>

        <div asp-validation-summary="ModelOnly" class="text-danger auth-summary"></div>

        <form asp-controller="Account"
              asp-action="Register"
              method="post"
              enctype="multipart/form-data">

            <div class="auth-field">
                <input asp-for="Login" class="form-control auth-input" placeholder="Login" />
                <span asp-validation-for="Login" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <input asp-for="Email" class="form-control auth-input" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <input asp-for="Password" type="password" class="form-control auth-input" placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <input asp-for="ConfirmPassword" type="password" class="form-control auth-input" placeholder="Confirm password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <input asp-for="FullName" class="form-control auth-input" placeholder="Full name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <textarea asp-for="Bio" class="form-control auth-input auth-textarea" placeholder="Information about user"></textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <input asp-for="PhoneNumber" class="form-control auth-input" placeholder="Phone number" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <select asp-for="Gender" class="form-control auth-input">
                    <option value="@Gender.NotSpecified">Not specified</option>
                    <option value="@Gender.Female">Female</option>
                    <option value="@Gender.Male">Male</option>
                    <option value="@Gender.Other">Other</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <div class="auth-upload-wrapper">
                <label for="AvatarFile" class="auth-upload-block">
                    <div class="auth-avatar-preview">
                        <i class="bi bi-person-circle"></i>
                        <span class="auth-plus-badge">
                            <i class="bi bi-plus"></i>
                        </span>
                    </div>

                    <div class="auth-upload-title">Upload photo</div>
                    <div class="auth-upload-note">JPG, JPEG, PNG or WEBP</div>
                </label>

                <input asp-for="AvatarFile"
                       id="AvatarFile"
                       type="file"
                       class="d-none"
                       accept=".jpg,.jpeg,.png,.webp" />

                <span asp-validation-for="AvatarFile" class="text-danger d-block text-center"></span>
            </div>

            <button type="submit" class="btn auth-submit-button">
                Sign up
            </button>
        </form>
    </div>

    <div class="auth-switch-card">
        <span>Already have an account?</span>
        <a asp-controller="Account" asp-action="Login" class="auth-switch-link">Log in</a>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}