@model HW_58.Models.User

@{
    ViewData["Title"] = "Profile";
    bool isMyProfile = ViewBag.IsMyProfile;
}

<div class="row mb-4">
    <div class="col-md-3 text-center">
        <img src="@Model.AvatarPath"
             alt="Avatar"
             style="width: 170px; height: 170px; object-fit: cover; border-radius: 50%;" />
    </div>

    <div class="col-md-9">
        <h2>@Model.UserName</h2>

        <p>
            <strong>@Model.FullName</strong>
        </p>

        <p>@Model.Bio</p>

        <div class="d-flex gap-4 mb-3">
            <span><strong>@Model.PostsCount</strong> posts</span>
            <span><strong>@Model.FollowersCount</strong> followers</span>
            <span><strong>@Model.FollowingCount</strong> following</span>
        </div>

        @if (isMyProfile)
        {
            <a asp-controller="Post" asp-action="Create" class="btn btn-primary">
                Add post
            </a>
        }
    </div>
</div>

<hr />

<h3>Posts</h3>

@if (Model.Posts.Count == 0)
{
    <p>No posts yet.</p>
}
else
{
    <div class="row">
        @foreach (Post post in Model.Posts.OrderByDescending(post => post.CreatedOn))
        {
            <div class="col-md-4 mb-4">
                <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">
                    <img src="@post.ImagePath"
                         alt="Post image"
                         style="width: 100%; height: 300px; object-fit: cover;" />
                </a>
            </div>
        }
    </div>
}