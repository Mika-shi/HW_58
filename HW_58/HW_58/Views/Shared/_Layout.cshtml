<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - HW_58</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/HW_58.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
<header class="instagram-header">
    <div class="instagram-header-inner">

        <a asp-controller="Home"
           asp-action="Index"
           class="instagram-brand">
            <i class="bi bi-instagram"></i>
            <span>Instagram</span>
        </a>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <form asp-controller="Users"
                  asp-action="Search"
                  method="get"
                  class="instagram-header-search">

                <i class="bi bi-search search-icon"></i>

                <input type="text"
                       name="keyword"
                       placeholder="Search"
                       autocomplete="off" />
            </form>
        }
        else
        {
            <div></div>
        }

        <div class="instagram-header-icons">

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="Home"
                   asp-action="Index"
                   class="instagram-icon-link"
                   title="Home">
                    <i class="bi bi-house-door"></i>
                </a>

                <a asp-controller="Post"
                   asp-action="Create"
                   class="instagram-icon-link"
                   title="Create post">
                    <i class="bi bi-plus-square"></i>
                </a>

                <a asp-controller="Profile"
                   asp-action="Index"
                   class="instagram-icon-link"
                   title="My profile">
                    <i class="bi bi-person-circle"></i>
                </a>
            }

            <div class="dropdown">
                <button class="instagram-menu-button"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>

                <ul class="dropdown-menu dropdown-menu-end">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li>
                            <a class="dropdown-item"
                               asp-controller="Profile"
                               asp-action="Index">
                                <i class="bi bi-person me-2"></i>
                                My profile
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Post"
                               asp-action="Create">
                                <i class="bi bi-plus-square me-2"></i>
                                Create post
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Users"
                               asp-action="Search">
                                <i class="bi bi-search me-2"></i>
                                Search users
                            </a>
                        </li>

                        <li><hr class="dropdown-divider" /></li>

                        <li>
                            <form asp-controller="Account"
                                  asp-action="SwitchAccount"
                                  method="post">

                                <button type="submit"
                                        class="dropdown-item">
                                    <i class="bi bi-arrow-left-right me-2"></i>
                                    Switch account
                                </button>
                            </form>
                        </li>

                        <li>
                            <form asp-controller="Account"
                                  asp-action="RegisterNewAccount"
                                  method="post">

                                <button type="submit"
                                        class="dropdown-item">
                                    <i class="bi bi-person-plus me-2"></i>
                                    Register new account
                                </button>
                            </form>
                        </li>

                        <li>
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                <button type="submit"
                                        class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="dropdown-item"
                               asp-controller="Account"
                               asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Login
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Account"
                               asp-action="Register">
                                <i class="bi bi-person-plus me-2"></i>
                                Register
                            </a>
                        </li>
                    }

                </ul>
            </div>

        </div>
    </div>
</header>


<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - HW_58 - Hope you will give me a good grade ;)
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>